# Copie este archivo a `.env` (ignorado por Git) y sustituya TODOS los placeholders.
# Genere secretos con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- PostgreSQL (Docker, infra/compose.yml) ---
POSTGRES_USER=alertasegura
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=alertasegura
# Si el puerto 5432 ya lo usa otro PostgreSQL local, cambie aquí y en DATABASE_URL (p. ej. 5433).
POSTGRES_PORT=5432
# Dos roles SQL (semana 2): el propietario migra y siembra; la API corre con el rol `alertasegura_app`, que solo
# tiene SELECT/INSERT en las tablas inmutables y en la auditoría (P07). `pnpm db:roles` crea ese rol tras las migraciones.
# Propietario (db:deploy, db:seed, db:roles, lab). Misma contraseña que POSTGRES_PASSWORD.
DATABASE_MIGRATION_URL=postgresql://alertasegura:change-me-locally@localhost:5432/alertasegura
# Contraseña del rol alertasegura_app (mínimo 16 caracteres; genérela con el comando de arriba).
APP_DB_PASSWORD=replace-with-a-random-password-of-16-or-more-chars
# La API: rol alertasegura_app con la contraseña de APP_DB_PASSWORD.
DATABASE_URL=postgresql://alertasegura_app:replace-with-a-random-password-of-16-or-more-chars@localhost:5432/alertasegura

# --- API (apps/api) ---
NODE_ENV=development
PORT=3000
# Origen de la PWA: se rechaza cualquier cabecera Origin distinta en métodos no seguros.
WEB_ORIGIN=http://localhost:5173
# Secreto HMAC del token CSRF. Mínimo 32 bytes. OBLIGATORIO y aleatorio.
CSRF_SECRET=replace-with-at-least-32-random-bytes-hex
# true bajo HTTPS: cookies Secure y prefijo __Host-.
COOKIE_SECURE=false
# false = la IP es la del socket y X-Forwarded-For se ignora. Un entero N = confiar en N proxies.
TRUST_PROXY=false
BODY_LIMIT=100kb

# Sesión: caducidad absoluta (8 h) e inactividad (30 min)
SESSION_ABSOLUTE_TTL_MINUTES=480
SESSION_IDLE_TTL_MINUTES=30

# Rate limiting (memoria del proceso). Valores del contrato.
RATE_LOGIN_IP_LIMIT=10
RATE_LOGIN_IP_WINDOW_SECONDS=60
RATE_LOGIN_ACCOUNT_LIMIT=5
RATE_LOGIN_ACCOUNT_WINDOW_SECONDS=900
RATE_USER_LIMIT=120
RATE_USER_WINDOW_SECONDS=60
RATE_GLOBAL_LIMIT=300
RATE_GLOBAL_WINDOW_SECONDS=60

# --- Firmante y confianza (semana 2) ---
# Canal HTTP de la API hacia el firmante aislado. En Linux/Docker es un socket Unix; en Windows, una named pipe
# (por ejemplo \\.\pipe\alertasegura-signer). Sin firmante, publicar y cancelar responden 503 SIGNER_UNAVAILABLE.
SIGNER_SOCKET_PATH=/run/signer/signer.sock
SIGNER_TIMEOUT_MS=3000
# Manifiesto de confianza firmado por la raíz (lo emite la CLI offline). Vacío = GET /trust/manifest responde 503.
TRUST_MANIFEST_FILE=

# --- Seed (pnpm db:seed). Si falta la contraseña de un usuario, ese usuario no se crea. ---
# Contraseñas de al menos 12 caracteres. No use valores reales en este archivo de ejemplo.
SEED_ADMIN_EMAIL=admin@alertasegura.local
SEED_ADMIN_NAME="Administrador Local"
SEED_ADMIN_PASSWORD=
SEED_AUDITOR_EMAIL=auditor@alertasegura.local
SEED_AUDITOR_PASSWORD=
SEED_ISSUER1_EMAIL=emisor1@alertasegura.local
SEED_ISSUER1_PASSWORD=
SEED_ISSUER2_EMAIL=emisor2@alertasegura.local
SEED_ISSUER2_PASSWORD=

# Ruta local; la clave nunca debe almacenarse en Git.
SIGNER_PRIVATE_KEY_FILE=./secrets/signer-private-key.pem
