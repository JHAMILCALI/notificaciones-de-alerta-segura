# Dependencies and build output
# Dependencias locales de cualquier workspace (nunca se versionan)
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm/
dist/
coverage/
*.tsbuildinfo

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
infra/secrets/
# Claves y manifiestos del laboratorio (semana 2): la clave del firmante y el manifiesto emitido localmente.
# La clave raíz se guarda FUERA del repositorio (~/.alertasegura-lab por defecto).
secrets/
*.private.jwk

# Logs and editor files
*.log
# Salidas reales de comandos que forman parte de la evidencia de los gates
!docs/evidence/**/*.log
.idea/
.vscode/
.DS_Store
Thumbs.db

# Worktrees de los agentes de la semana 2 (shiro, moto): cada uno trabaja en su rama; las ramas y sus commits
# viven en el repositorio, la carpeta es solo la copia de trabajo local.
.worktrees/
