{
  "name": "alertasegura",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter @alertasegura/shared --filter @alertasegura/database --filter @alertasegura/verification build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @alertasegura/web --filter @alertasegura/api dev",
    "dev:web": "pnpm --filter @alertasegura/web dev",
    "dev:api": "pnpm --filter @alertasegura/api dev",
    "db:up": "docker compose -f infra/compose.yml --env-file .env up -d --wait postgres",
    "db:down": "docker compose -f infra/compose.yml --env-file .env down",
    "db:generate": "pnpm --filter @alertasegura/database db:generate",
    "db:migrate": "pnpm --filter @alertasegura/database db:migrate",
    "db:deploy": "pnpm --filter @alertasegura/database db:deploy",
    "db:seed": "pnpm --filter @alertasegura/database db:seed",
    "db:roles": "pnpm --filter @alertasegura/database db:roles",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @alertasegura/api test:e2e",
    "lint": "pnpm -r --if-present lint",
    "test:g1": "node tests/security/g1-acceptance.mjs",
    "test:browser": "node tests/security/browser-walkthrough.mjs",
    "test:cleanup": "node tests/security/cleanup-test-drafts.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
