{
  "name": "@alertasegura/trust-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "alertasegura-trust": "./dist/main.js"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@alertasegura/shared": "workspace:*",
    "@alertasegura/verification": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
